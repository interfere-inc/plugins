{
  "mcpServers": {
    "interfere": {
      "type": "http",
      "url": "https://mcp.interfere.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "oidcEnabled": false,
            "defaultScopes": ["interfere:access", "user:org:read", "offline_access"]
          }
        }
      }
    }
  }
}
